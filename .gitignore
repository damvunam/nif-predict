# GitHub holds CODE ONLY: Python, tests (+ tests/baseline), config, scripts, dvc.yaml/dvc.lock, pyproject,
# README.md, .gitignore and data/public/MANIFEST.tsv. Data, outputs and notes stay local.

# Python, tools, editors
.venv/
venv/
env/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
.DS_Store
.env

# Local notes (never committed)
.claude/
review/
GEMINI.md
/notes/
*.md
!/README.md

# Outputs: one root, never committed (+ ML run folders)
/results/
/models/
/mlruns/
/logs/

# Data: only the public-data manifest and the small ML config files are tracked
/data/*
!/data/public/
/data/public/*
!/data/public/MANIFEST.tsv
!/data/*.dvc
!/data/batch_accessions.txt
!/data/labels/
/data/labels/*
!/data/labels/label_manifest.csv

# Safety net: sequence/genome/database/archive files are never committed, wherever they are
